# Environment for running core, the worker and the UI against dev/compose.yaml.
# Load it in each terminal with: set -a; . dev/local.env; set +a
# Every variable is described at /installation/configuration.

# Connections
DB_HOST=127.0.0.1
DB_NAME=fantasy_football
DB_USER=bot_admin
DB_PASSWORD=fantasy-local-only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
AMQP_URL=amqp://fantasy:fantasy-local-only@127.0.0.1:5672/%2f
CORE_API_BASE_URL=http://127.0.0.1:8000
CORE_PIPELINE_URL=http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
TRIGGER_API_KEY=local-dev-trigger-key

# Every bot dry-runs. Remove these only once you trust the stack (see /installation/dry-run).
DRY_RUN=true
TRADE_DRY_RUN=true

# Your league. Fill these in from ESPN (see /installation/first-run).
CURRENT_YEAR=2026
# ESPN_LEAGUE_ID=
# ESPN_TEAM_ID=
# ESPN_S2=
# ESPN_SWID=
# SWID=
